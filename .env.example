# Copy to .env and adjust for your environment.
FLASK_ENV=development
FLASK_APP=run:app

# PostgreSQL (SQLAlchemy URL)
# Database name below is "procurement"; set password to match your PostgreSQL role.
DATABASE_URL=postgresql://procurement:admin1212@localhost:5432/procurement

SECRET_KEY=replace-with-long-random-string
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=52428800
