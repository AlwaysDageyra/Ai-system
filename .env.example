FLASK_ENV=development
FLASK_APP=run_backend:app

# Leave DATABASE_URL unset to use local SQLite at instance/procurement.sqlite3.
# To use PostgreSQL instead, uncomment and edit:
# DATABASE_URL=postgresql://procurement:yourpassword@127.0.0.1:5432/procurement

SECRET_KEY=ProcurementSystem@2026SecureKey
JWT_SECRET_KEY=ProcurementJwt@2026SecureKeyChangeMe

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# RoBERTa requirement classifier (binary: requirement=1 / not=0)
MODEL_PATH=models/roberta_tender_model
